{
  "query": "\nSELECT CONCAT(state_code, ' Senate') as race, state_code, candidate1_name, candidate1_party, ROUND(candidate1_vote_pct,1) as c1pct,\n       candidate2_name, candidate2_party, ROUND(candidate2_vote_pct,1) as c2pct,\n       pct_reporting, primary_winner, primary_party, status\nFROM senate_races WHERE state_code IN ('NE','WV','OH')\nUNION ALL\nSELECT CONCAT(state_code, '-', district) as race, state_code, candidate1_name, candidate1_party, ROUND(candidate1_vote_pct,1) as c1pct,\n       candidate2_name, candidate2_party, ROUND(candidate2_vote_pct,1) as c2pct,\n       pct_reporting, primary_winner, primary_party, status\nFROM house_races WHERE state_code IN ('NE','WV','OH','IN') AND (primary_winner IS NOT NULL OR pct_reporting > 0)\nORDER BY race;\n",
