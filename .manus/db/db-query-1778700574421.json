{
  "query": "\nSELECT 'governor' as chamber, state_name, dem_candidate as c1_name, 'D' as c1_party, rep_candidate as c2_name, 'R' as c2_party, rating\nFROM governor_races\nWHERE dem_candidate IS NOT NULL AND rep_candidate IS NOT NULL\nORDER BY rating;\n\nSELECT 'house' as chamber, CONCAT(state_code, '-', district_label) as state_name, \n  candidate1_name as c1_name, candidate1_party as c1_party, \n  candidate2_name as c2_name, candidate2_party as c2_party, rating\nFROM house_races\nWHERE candidate1_name IS NOT NULL AND candidate2_name IS NOT NULL\n  AND rating IN ('Toss-up', 'Lean D', 'Lean R', 'Likely D', 'Likely R')\nORDER BY rating, state_code;\n",
