{
  "query": "\nSELECT \n  state_code, district, rating,\n  candidate1_name, candidate1_party,\n  candidate2_name, candidate2_party\nFROM house_races\nWHERE status = 'General'\n  AND candidate1_name IS NOT NULL \n  AND candidate2_name IS NOT NULL\nORDER BY \n  CASE rating \n    WHEN 'Toss-up' THEN 1 \n    WHEN 'Lean D' THEN 2 \n    WHEN 'Lean R' THEN 3 \n    WHEN 'Likely D' THEN 4 \n    WHEN 'Likely R' THEN 5 \n    WHEN 'Solid D' THEN 6 \n    WHEN 'Solid R' THEN 7 \n    ELSE 8 \n  END, state_code, district\nLIMIT 100;\n",
